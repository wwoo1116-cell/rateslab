# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. 실제 값이 아니라 **키 목록**이고, 이게 리포에
# 없으면 다음 사람이 무엇을 설정해야 하는지 알 길이 없다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── sauron-v2 ──────────────────────────────────────────────────────────────
# the copied backend's runtime artefacts
backend/.cache/
data/.cache/
backend.log
refresh.log
__pycache__/
*.pyc
.pytest_cache/

# vitest
/coverage

# impeccable 스킬의 런타임 스크래치(pid/port/token). 어제 세션이 남긴 것이
# `git add -A` 로 딸려 들어간 적이 있다 — 커밋에 들어갈 내용이 아니다.
# `.impeccable/critique/` 는 산출물이라 추적한다.
.impeccable/live/

# 개발 서버 로그 (재기동 시 만들어짐)
.dev.log

# ── 이관된 엔진의 데이터 (backend/bigfoot, 2026-08-21) ──────────────────────
# 공개 API 캐시(`backend/data/raw/*.csv`)는 **추적한다** — ECOS·FRED 응답이라
# 재현에 필요하고 위생 가드의 면제 대상이다. 아래 셋은 회사·터미널 자료라
# 절대 안 들어간다. BIGFOOT 의 .gitignore 에서 그대로 옮겨 온 규칙이다.
backend/data/krwswapdata/raw/
backend/data/krwswapdata/clean.parquet
backend/data/krd_ladder.json
# 엔진이 굽는 HTML 리포트 — 산출물이지 소스가 아니다. JSON 계약만 추적한다.
backend/output/*.html
backend/data/paper_book.json
# 초기화가 남기는 옛 장부 — 장부와 같은 부류다(기록이지 소스가 아니다).
backend/data/paper_archive/
backend/output/.tenor_run*.log
backend/output/.tenor_search_cache*.json
